<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway clean consumer for tools/release-drill.sh. The script copies this file outside the
    repository and replaces @VERSION@. The only dependency is the package from the drill's local feed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Starlings.Tokenizers" Version="[@VERSION@]" />
  </ItemGroup>

</Project>
